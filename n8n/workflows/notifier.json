      "typeVersion": 3.4,
      "position": [
        -656,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.apiBaseUrl }}/internal/notifications",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Evento a notificar').first().json.kind === 'run' ? { kind: 'run', runId: $('Evento a notificar').first().json.runId } : { kind: $('Evento a notificar').first().json.kind, messageId: $('Evento a notificar').first().json.messageId }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "1811c00a-5389-4736-9db0-2af168cc8805",
      "name": "Registrar notificación",
