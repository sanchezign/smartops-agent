{
  "name": "SmartOps · Notificador",
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000017",
      "name": "Evento a notificar",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "cfg00000-0000-4000-8000-000000000001",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-api-base",
              "name": "apiBaseUrl",
              "value": "http://host.docker.internal:4000/api/v1",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000018",
      "name": "Registrar notificación",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "SmartOps API"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.apiBaseUrl }}/internal/notifications",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Evento a notificar').first().json.kind === 'run' ? { kind: 'run', runId: $('Evento a notificar').first().json.runId } : { kind: $('Evento a notificar').first().json.kind, messageId: $('Evento a notificar').first().json.messageId }) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000019",
      "name": "¿Es una lista?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "es-lista",
              "leftValue": "={{ $('Evento a notificar').first().json.kind }}",
              "rightValue": "run",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000020",
      "name": "Acuse al proveedor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "SmartOps API"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.apiBaseUrl }}/internal/messages/ack",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ runId: $('Evento a notificar').first().json.runId }) }}",
        "options": {
          "timeout": 60000
        }
      }
    }
  ],
  "connections": {
    "Evento a notificar": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Registrar notificación",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Registrar notificación": {
      "main": [
        [
          {
            "node": "¿Es una lista?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Es una lista?": {
      "main": [
        [
          {
            "node": "Acuse al proveedor",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": ""
  },
  "active": false
}
