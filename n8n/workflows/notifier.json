      "position": [
        -448,
        80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "z2Bc0g3xCfJgYXmZ",
          "name": "SmartOps API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "es-lista",
              "leftValue": "={{ $('Evento a notificar').first().json.kind }}",
              "rightValue": "run",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0c48e73b-9539-49d5-82af-feaca7748c1f",
      "name": "¿Es una lista?",
