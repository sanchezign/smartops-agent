      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -880,
        80
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-api-base",
              "name": "apiBaseUrl",
              "value": "http://host.docker.internal:4000/api/v1",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "a6871fcd-2b1a-41fc-b9fb-3014ecc36f18",
