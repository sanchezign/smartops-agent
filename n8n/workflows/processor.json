                "conditions": [
                  {
                    "id": "estado-extraida",
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "extracted",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "extraída"
