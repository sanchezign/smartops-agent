                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "estado-extrayendo",
                    "leftValue": "={{ $json.status === 'extracting' && $runIndex < 30 }}",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "extrayendo (esperar)"
            }
          ]
        },
        "options": {
