        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "cfg00000-0000-4000-8000-000000000001",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-api-base",
              "name": "apiBaseUrl",
              "value": "http://host.docker.internal:4000/api/v1",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000002",
      "name": "Clasificar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "SmartOps API"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.apiBaseUrl }}/internal/classify",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messageId: $('Mensaje listo').first().json.body.messageId }) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000003",
      "name": "Ruta",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "ruta-lista",
                    "leftValue": "={{ $json.classification === null || ['price_list_full','price_update_partial'].includes($json.classification) }}",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "lista de precios"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "ruta-consulta",
                    "leftValue": "={{ $json.classification }}",
                    "rightValue": "customer_query",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "consulta de cliente"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "otro (fin)"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000004",
