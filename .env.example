# ─── Root .env — used by docker-compose.yml (local infra) ────────────────────
# Copy to .env and replace every "change-me". Never commit .env.
# App-specific vars live in apps/api/.env.example and apps/admin/.env.example.

# Postgres (app database). Published on 127.0.0.1:5432.
POSTGRES_USER=smartops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartops

# n8n database + role, created by docker/postgres/init/01-create-n8n-db.sh.
# Only applied when the postgres volume is created for the first time.
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me

# Encrypts credentials stored by n8n. Generate once and NEVER change it
# (changing it makes saved credentials unreadable):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=change-me

# Public base URL n8n uses to build webhook URLs (a tunnel URL when testing
# real Meta webhooks locally). UI published on 127.0.0.1:5678.
N8N_WEBHOOK_URL=http://localhost:5678/

# Timezone for n8n (schedules, dates).
TIMEZONE=America/Montevideo
