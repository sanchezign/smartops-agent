# ─── apps/admin ─────────────────────────────────────────────
# Copy to apps/admin/.env.local. Read ONLY through src/env.ts (Zod).

# Where the browser calls the API. Default "/api/v1" = SAME ORIGIN as the panel (phase 8,
# ADR-018): the refresh cookie stays first-party (SameSite=Strict).
#   - Demo (deploy option D, Oracle VM): Caddy routes /api to the API → keep the default.
#   - Local dev / option A (Vercel): Next rewrites /api/* to API_PROXY_TARGET.
NEXT_PUBLIC_API_BASE=/api/v1

# Server only: the API origin the /api/* rewrite forwards to (no path). Defaults to
# http://localhost:4000 outside production; unset in option D (Caddy does the routing).
API_PROXY_TARGET=http://localhost:4000
