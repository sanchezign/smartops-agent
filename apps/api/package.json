{
  "name": "@smartops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run \"/^dev:(api|worker)$/\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "wa:subscribe": "tsx --env-file-if-exists=.env scripts/whatsapp-subscribe.ts",
    "wa:simulate": "tsx --env-file-if-exists=.env scripts/simulator/simulate.ts",
    "wa:fake-graph": "tsx --env-file-if-exists=.env scripts/simulator/fake-graph-cli.ts",
    "wa:media:retry": "tsx --env-file-if-exists=.env scripts/media-retry.ts",
    "wa:send": "tsx --env-file-if-exists=.env scripts/whatsapp-send.ts",
    "wa:transcription:retry": "tsx --env-file-if-exists=.env scripts/transcription-retry.ts",
    "wa:fixtures:capture": "tsx --env-file-if-exists=.env scripts/capture-whatsapp-fixtures.ts",
    "ai:record-golden": "tsx --env-file-if-exists=.env scripts/ai-record-golden.ts",
    "n8n:replay": "tsx --env-file-if-exists=.env scripts/n8n-replay.ts",
    "n8n:export": "tsx scripts/n8n/export.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "^2.8.6",
    "csv-parse": "7.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fflate": "0.8.3",
    "helmet": "^8.3.0",
    "htmlparser2": "12.0.0",
    "mammoth": "1.12.3",
    "pg": "^8.23.0",
    "pg-boss": "^12.34.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
