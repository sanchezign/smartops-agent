# ─── apps/api ────────────────────────────────────────────────────────────────
# Copy to apps/api/.env. Validated by src/config/env.ts (Zod): the API refuses
# to start and lists every problem if something is missing or invalid.
# `pnpm dev` / `pnpm start` load this file with Node's --env-file-if-exists;
# prisma.config.ts loads it for the Prisma CLI. On Render, set vars in the dashboard.

# development | test | production
NODE_ENV=development
PORT=4000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Postgres from the root docker-compose.yml (published on 127.0.0.1:5432).
# User/password must match POSTGRES_USER / POSTGRES_PASSWORD in the root .env.
# No ?schema= param: the pg driver adapter ignores it (default schema: public).
DATABASE_URL=postgresql://smartops:change-me@localhost:5432/smartops

# Comma-separated browser origins allowed by CORS (the admin panel).
# Bare origins only (scheme + host + port, no path). "*" is rejected.
# Required in production.
CORS_ORIGINS=http://localhost:3000

# Global rate limit for /api/v1 per client IP (health check excluded).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Number of reverse-proxy hops in front of the API, so req.ip is the real client
# IP (needed by the rate limiter). 0 locally, 1 on Render.
TRUST_PROXY=0

# ─── WhatsApp Business Cloud API (Meta) ──────────────────────────────────────
# All values come from the Meta App Dashboard. Never commit real values.

# Graph API version used for every call (https://developers.facebook.com/docs/graph-api/changelog).
WHATSAPP_GRAPH_API_VERSION=v26.0

# Graph API host. Keep the default for real Meta. For local development without a
# Meta account point it at the fake Graph API (`pnpm --filter @smartops/api wa:fake-graph`):
#   WHATSAPP_GRAPH_BASE_URL=http://localhost:4010
# Rejected in production unless it is https://graph.facebook.com.
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com

# WhatsApp → API Setup: "Phone number ID" and "WhatsApp Business Account ID" (numeric).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=

# Access token. The "temporary" token from API Setup expires after ~24h; for anything
# longer-lived use a System User token (Business settings → System users) with
# whatsapp_business_messaging + whatsapp_business_management.
WHATSAPP_ACCESS_TOKEN=

# App settings → Basic → App secret. Used to verify X-Hub-Signature-256 on webhooks.
WHATSAPP_APP_SECRET=

# Random string YOU choose (min 16 chars), e.g. `openssl rand -hex 24` or
# `node -e "console.log(crypto.randomBytes(24).toString('hex'))"`.
# Paste the same value in WhatsApp → Configuration → Webhook → Verify token.
WHATSAPP_VERIFY_TOKEN=

# Timeout for every Graph API request (ms).
WHATSAPP_API_TIMEOUT_MS=15000

# Per-IP rate limit for POST/GET /api/v1/webhooks/whatsapp (per RATE_LIMIT_WINDOW_MS).
# Meta delivers from many IPs; keep it generous.
WEBHOOK_RATE_LIMIT_MAX=600

# ─── Worker (pg-boss) ────────────────────────────────────────────────────────
# The worker (`pnpm --filter @smartops/api dev:worker` / `start:worker`) processes
# webhook events from the pg-boss queue (schema `pgboss` in DATABASE_URL).
# Parallel webhook-processing jobs per worker process (1-20).
WORKER_CONCURRENCY=2

# ─── Media (ADR-008) ─────────────────────────────────────────────────────────
# Media is downloaded by the worker and stored in Postgres (bytea, table media_blobs).
# Own size cap in bytes on top of Meta limits (image 5 MB, audio 16 MB, document 100 MB).
# Each download is buffered in memory: peak ≈ MEDIA_MAX_BYTES × MEDIA_WORKER_CONCURRENCY.
MEDIA_MAX_BYTES=26214400
# Timeout for each media download (ms).
MEDIA_DOWNLOAD_TIMEOUT_MS=60000
# Parallel media downloads per worker process (1-10).
MEDIA_WORKER_CONCURRENCY=2

# ─── Outbound messages ───────────────────────────────────────────────────────
# Parallel outbound sends per worker process. Messages to the SAME conversation always
# go out in order (pg-boss key_strict_fifo); different conversations run in parallel.
OUTBOUND_WORKER_CONCURRENCY=2

# ─── Speech-to-text (ADR-005, ADR-010) ───────────────────────────────────────
# Transcribes WhatsApp voice notes. Cost constraint: Groq FREE plan only
# (whisper-large-v3: 20 req/min, 2,000 req/day, 7,200 audio s/hour, 28,800 audio s/day).
# groq | openai | fake. "fake" (default) needs no key: it returns the transcript
# registered with `wa:simulate audio --transcript "…"`. Not allowed in production.
TRANSCRIPTION_PROVIDER=fake
# Required unless fake. Groq: console.groq.com → API Keys. Never commit it.
# REQUIRED on every Groq account (dev, demo, client): enable Zero Data Retention in
# Settings → Data Controls (Global ZDR or Inference APIs ZDR). Without it Groq may retain
# inputs/outputs (including audio transcriptions) for up to 30 days (ADR-010).
TRANSCRIPTION_API_KEY=
# Optional overrides (defaults per provider). Groq: https://api.groq.com/openai/v1 +
# whisper-large-v3. OpenAI does NOT accept ogg voice notes without transcoding.
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_MODEL=
# ISO-639-1 language hint.
TRANSCRIPTION_LANGUAGE=es
# Timeout per transcription request (ms).
TRANSCRIPTION_TIMEOUT_MS=60000
# Fake provider transcripts directory (relative to apps/api).
TRANSCRIPTION_FAKE_DIR=.sim/transcripts
# Parallel transcriptions per worker process (Groq free plan: 20 requests/minute).
TRANSCRIPTION_WORKER_CONCURRENCY=2
# Max transcriptions per contact in a rolling 24h window (over it: skipped, quota_exceeded).
TRANSCRIPTION_DAILY_LIMIT_PER_CONTACT=50

# ─── n8n delivery (phase 6, ADR-015) ────────────────────────────────────────────
# Every inbound message that is READY (text, stored/failed media, transcribed voice note,
# converted document) creates a "message.ready" outbox event, delivered by the worker to
# the n8n receiver webhook with retries for ~24 h. Off (default): events accumulate and are
# delivered once enabled. Replay failed ones: pnpm --filter @smartops/api n8n:replay
N8N_DELIVERY_ENABLED=false
# Production URL of the receiver's Webhook node (the workflow must be PUBLISHED in n8n).
N8N_RECEIVER_WEBHOOK_URL=http://localhost:5678/webhook/smartops-message-ready
# Secret n8n checks (Webhook node → Header Auth credential, header X-SmartOps-Secret).
# Required when N8N_DELIVERY_ENABLED=true, min 32 chars. Never commit it.
N8N_WEBHOOK_SECRET=

# ─── Document conversion (ADR-013) ──────────────────────────────────────────────
# xlsx / xls / csv / txt / docx are converted to text (Markdown tables) by the worker, in
# an isolated thread (heap limit + timeout), before extraction. PDFs and images go to
# Claude as-is. Security limits (not editable from the panel):
DOC_CONVERT_MAX_BYTES=10485760
DOC_CONVERT_MAX_SHEETS=10
DOC_CONVERT_MAX_ROWS=2000
DOC_CONVERT_MAX_COLUMNS=50
# Max characters of converted text (≈ 13k tokens ≈ $0.027 of input with Sonnet 5).
DOC_CONVERT_MAX_CHARS=40000
DOC_CONVERT_TIMEOUT_MS=20000
DOC_CONVERT_WORKER_CONCURRENCY=1

# ─── AI / LLM (ADR-011) ───────────────────────────────────────────────────────
# anthropic | fake. "fake" (default) needs no key: recorded golden outputs + heuristics.
# Forbidden in production. Cost constraint: ~5 USD of Claude credits for the whole project.
AI_PROVIDER=fake
# console.anthropic.com → API Keys. Set a spend limit in the Console too. Never commit it.
ANTHROPIC_API_KEY=
# Model ids (verified 2026-09-25). A model without a verified price in src/ai/pricing.ts
# is refused at startup. Haiku 4.5 (claude-haiku-4-5) retires not sooner than 2026-10-15.
AI_CLASSIFIER_MODEL=claude-sonnet-5
AI_EXTRACTOR_MODEL=claude-sonnet-5
# Timeout per LLM call (ms).
AI_TIMEOUT_MS=60000
# Own spend caps, checked BEFORE every call with a worst-case estimate (USD, UTC days).
AI_TOTAL_BUDGET_USD=4.00
AI_DAILY_BUDGET_USD=0.50
# Cap per ingestion run: every AI call made for ONE message (classify + extract; later the
# chunks of a long document). A document whose estimate exceeds it goes to human review.
AI_MAX_RUN_USD=0.30
# Max extractions per contact per UTC day.
AI_DAILY_LIMIT_PER_CONTACT=20
# Cache system prompts (true|false). Measured per call in ai_usages.cache_*_tokens.
AI_PROMPT_CACHE=true
# Fake provider golden outputs directory (relative to apps/api).
AI_FAKE_GOLDEN_DIR=test/fixtures/extraction/golden

# ─── Internal API for n8n ───────────────────────────────────────────────────
# Shared secret n8n sends in the X-Internal-Api-Key header to /api/v1/internal/*
# (classify, extract, catalog/ingest, rules). REQUIRED, min 32 chars, e.g.
# `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`. Store it in n8n as a
# credential (Header Auth), never in an exported workflow. Never commit it.
INTERNAL_API_KEY=
# Per-IP rate limit for /api/v1/internal/* (per RATE_LIMIT_WINDOW_MS).
INTERNAL_RATE_LIMIT_MAX=600

# ─── Panel auth (phase 8, ADR-018) ─────────────────────────────────────────────
# HS256 key for the 15-min access tokens. REQUIRED, random, min 32 chars, e.g.
# `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`. Changing it logs
# everybody out of the panel (refresh sessions keep working and issue new tokens).
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
# Session ends after this long without a refresh, and in any case after SESSION_MAX_DAYS.
SESSION_IDLE_HOURS=24
SESSION_MAX_DAYS=7
# Refresh cookie (HttpOnly, Path=/api/v1/auth):
#   strict = panel and API on the SAME ORIGIN (demo: VM + Caddy, "/" panel + "/api" API;
#            or a Vercel rewrite of /api to the API). Recommended.
#   lax    = same site (panel.example.com + api.example.com).
#   none   = cross-site (e.g. *.vercel.app ↔ another domain): needs Secure; also set
#            AUTH_COOKIE_PARTITIONED=true for Safari (CHIPS). Fragile — avoid if possible.
AUTH_COOKIE_SAMESITE=strict
# auto = Secure in production (HTTPS), not on http://localhost in development.
AUTH_COOKIE_SECURE=auto
AUTH_COOKIE_PARTITIONED=false
# Login attempts per IP per 15 minutes (the per-account lockout is separate).
LOGIN_RATE_LIMIT_MAX=10

# ─── Panel real time (phase 9 M4, ADR-020) ────────────────────────────────────
# One Postgres LISTEN connection per API process fans events out to the SSE streams.
# Open streams per user (tabs + phone) and per process; beyond → 429 TOO_MANY_STREAMS.
SSE_MAX_STREAMS_PER_USER=5
SSE_MAX_STREAMS=500
# Heartbeat (s): keeps proxies from closing idle streams and re-checks the session.
SSE_HEARTBEAT_SECONDS=25
# Public URL of the panel (no trailing slash). WhatsApp digests end with
# "Ver en el panel: <PANEL_PUBLIC_URL>/d/<random token>" (login required; the URL carries no
# content). Empty = no link. HTTPS required in production.
PANEL_PUBLIC_URL=

# ─── Demo data (phase 9) ───────────────────────────────────────────────────────
# Separate database for the demo seed (screenshots, video, E2E, public demo). Its name MUST
# end in "_demo": `pnpm --filter @smartops/api demo:seed` wipes and refills it, and refuses
# any other name. Never point it at real data.
DEMO_DATABASE_URL=
# Demo operator: PUBLIC credentials by design (shown on the login screen in DEMO_MODE).
DEMO_OPERATOR_EMAIL=demo@smartops.test
DEMO_OPERATOR_PASSWORD=try smartops demo
# Demo admin: only created when a password is set (min 15 chars). No default.
DEMO_ADMIN_EMAIL=admin@ferreteria.demo
DEMO_ADMIN_PASSWORD=

# ─── Public demo: DEMO_MODE (phase 9 M8, ADR-021) ─────────────────────────────
# true = the public $0 demo. FORCES (whatever the other variables say): the fake LLM with the
# recorded outputs, the fake transcriber, and the fake Graph API served by THIS API — the
# Graph client refuses any Meta host, so no real WhatsApp message can leave. Enables
# /api/v1/demo/*, the "Probar el sistema" page and the credentials on the login screen.
# Requires DATABASE_URL to be a *_demo database (the demo resets its data). Set it on the API
# AND the worker. Allowed with NODE_ENV=production (the only case where fakes are allowed).
DEMO_MODE=false
# Where the worker reaches the API's fake Graph API (no path). Default http://127.0.0.1:PORT
# (same host); in docker compose use the API service, e.g. http://api:4000.
DEMO_GRAPH_URL=
# Automatic reset of the demo data every N minutes (0 = never). Users and sessions are kept.
DEMO_RESET_INTERVAL_MINUTES=60
# "Probar el sistema" buttons per IP per 10 minutes.
DEMO_RATE_LIMIT_MAX=20
# The same buttons per hour for ALL visitors together (they share the public operator, from any
# IP): bounds the total work strangers can trigger (phase 12).
DEMO_GLOBAL_INJECT_PER_HOUR=120
# Who plays the n8n workflows: "n8n" (default, the real system) or "internal" (ADR-025, DEMO_MODE
# only): an in-process orchestrator with the same steps, for a demo on a 1 GB VM. Its samples
# are processed one at a time. With "internal" no n8n is needed; run `node dist/demo-server.js`
# (API + worker + orchestrator in one process) or the worker alone.
DEMO_ORCHESTRATOR=n8n
# Where the internal orchestrator reaches the API (default http://127.0.0.1:PORT).
# DEMO_ORCHESTRATOR_API_URL=
# Public demo in production (DEMO_MODE + NODE_ENV=production): the API refuses to start if
# ANTHROPIC_API_KEY / TRANSCRIPTION_API_KEY / DEMO_ADMIN_PASSWORD are set or any variable holds
# something that looks like a real provider key (phase 12).
# Sample files, recorded LLM outputs and transcripts (relative to apps/api).
DEMO_ASSETS_DIR=demo
# E2E only (Playwright sets it): one review per browser project.
DEMO_E2E_REVIEWS=false

# ─── Tests ───────────────────────────────────────────────────────────────────
# Optional. Postgres database for integration tests (test/integration). Its name MUST
# end in "_test": the tests truncate its tables. Created and migrated automatically by
# the Vitest global setup. When unset, integration tests are skipped.
TEST_DATABASE_URL=postgresql://smartops:change-me@localhost:5432/smartops_test
