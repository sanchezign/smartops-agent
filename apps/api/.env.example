# ─── apps/api ────────────────────────────────────────────────────────────────
# Copy to apps/api/.env. Phase 2 adds a Zod env module that fails fast on startup.

NODE_ENV=development
PORT=4000

# Postgres from the root docker-compose.yml (published on 127.0.0.1:5432).
# User/password must match POSTGRES_USER / POSTGRES_PASSWORD in the root .env.
DATABASE_URL=postgresql://smartops:change-me@localhost:5432/smartops?schema=public
