# ─── apps/api ────────────────────────────────────────────────────────────────
# Copy to apps/api/.env. Validated by src/config/env.ts (Zod): the API refuses
# to start and lists every problem if something is missing or invalid.
# `pnpm dev` / `pnpm start` load this file with Node's --env-file-if-exists;
# prisma.config.ts loads it for the Prisma CLI. On Render, set vars in the dashboard.

# development | test | production
NODE_ENV=development
PORT=4000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Postgres from the root docker-compose.yml (published on 127.0.0.1:5432).
# User/password must match POSTGRES_USER / POSTGRES_PASSWORD in the root .env.
# No ?schema= param: the pg driver adapter ignores it (default schema: public).
DATABASE_URL=postgresql://smartops:change-me@localhost:5432/smartops

# Comma-separated browser origins allowed by CORS (the admin panel).
# Bare origins only (scheme + host + port, no path). "*" is rejected.
# Required in production.
CORS_ORIGINS=http://localhost:3000

# Global rate limit for /api/v1 per client IP (health check excluded).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Number of reverse-proxy hops in front of the API, so req.ip is the real client
# IP (needed by the rate limiter). 0 locally, 1 on Render.
TRUST_PROXY=0
