// SmartOps Agent — Prisma schema (Prisma 7, PostgreSQL via @prisma/adapter-pg).
// The datasource URL lives in prisma.config.ts (Prisma 7), not here.
//
// Conventions:
// - ids: UUIDv7 (time-ordered) stored as native uuid.
// - timestamps: timestamptz(3). Mutable models have createdAt + updatedAt.
// - money: Decimal(18,4), never Float. Serialized as string in JSON responses.
// - tables/columns: snake_case via @@map / @map.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

/// How a contact gave consent to receive business-initiated messages (ADR-009).
enum OptInSource {
  /// The contact wrote to us first (implicit opt-in).
  inbound
  /// Recorded by an operator/CLI after confirming consent outside WhatsApp.
  manual
}

enum ContactKind {
  supplier
  customer
  internal
  unknown
}

enum ConversationMode {
  bot
  human
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageType {
  text
  image
  document
  audio
  video
  sticker
  location
  contacts
  interactive
  button
  reaction
  template
  unsupported
}

/// Who authored the message: the external contact, the bot, or a human operator.
enum MessageAuthor {
  contact
  bot
  human
}

enum MessageStatus {
  received
  pending
  sent
  delivered
  read
  failed
}

enum IngestionClassification {
  price_list_full
  price_update_partial
  customer_query
  internal_order
  other
}

enum IngestionStatus {
  pending
  classified
  /// Claimed by one extraction (lock): concurrent requests never call the LLM twice.
  extracting
  extracted
  /// Claimed by one catalog ingest (lock).
  ingesting
  ingested
  needs_review
  failed
  /// A human rejected the run (run-level review): nothing of it is applied.
  rejected
}

enum AlertType {
  price_change
  low_stock
  missing_data
  ingestion_error
  /// Something a person must look at by hand (e.g. a voice note too long to transcribe).
  manual_attention
  /// n8n unreachable, workflow errors (phase 6).
  integration_error
}

/// Notifications (phase 6): only actionable events, grouped per recipient.
enum NotificationCategory {
  run_summary
  customer_query
  integration_error
  manual_attention
}

enum NotificationDigestStatus {
  /// Collecting items until windowEndsAt (or until the hourly cap allows sending).
  open
  sent
  /// WhatsApp not possible (window closed and no template / no opt-in): panel only.
  panel_only
  failed
}

/// Outbox towards n8n (phase 6, ADR-015).
enum IntegrationEventStatus {
  pending
  delivered
  /// Retries exhausted (~24 h): an alert is raised; `n8n:replay` sends it again.
  failed
}

enum AlertSeverity {
  info
  warning
  critical
}

enum AlertStatus {
  open
  sent
  acknowledged
  dismissed
}

/// Human review (ADR-012): what a review item blocks.
enum ReviewScope {
  /// Blocks the whole ingestion run (gate).
  run
  /// One extracted line.
  line
  /// A catalog-wide proposal (mark unavailable, global percentage).
  catalog
}

enum ReviewKind {
  product_match
  new_or_existing
  possible_duplicate
  match_conflict
  uncertain_value
  pct_without_match
  missing_currency
  currency_changed
  price_outlier
  stale_source
  mark_unavailable
  global_change
  tax_basis_changed
  suspicious_instructions
  unknown_supplier
  extraction_failed
  /// New spreadsheet format (or several price columns): a human approves the mapping.
  column_mapping
}

enum ReviewStatus {
  pending
  approved
  rejected
  /// A newer run or a catalog change made this proposal obsolete.
  superseded
}

enum PriceChangeSource {
  auto
  review
}

enum UserRole {
  admin
  operator
}

enum AuditActorType {
  user
  system
  n8n
}

enum MediaStatus {
  /// Waiting for the download job.
  pending
  stored
  /// Not downloaded by design (e.g. video, sticker).
  skipped
  /// Refused: unsupported mime, too large, content does not match its type.
  rejected
  /// Download impossible (media expired / not found) or retries exhausted.
  failed
}

enum AiTask {
  classify
  extract
  /// Spreadsheet column mapping (phase 5 M3c): header + sample rows only.
  map_columns
  /// Compact catalog matching of spreadsheet rows without an exact name match.
  match
}

/// Remembered spreadsheet format of a supplier (phase 5 M3c, ADR-014).
enum SheetFormatStatus {
  active
  /// Failed validation (> 20 % unreadable rows) or replaced: never deleted.
  retired
}

enum AiUsageStatus {
  ok
  /// Provider/validation error (tokens may still have been billed).
  error
  /// Refused before calling the provider: a budget or per-contact limit would be exceeded.
  budget_blocked
}

/// Document conversion (phase 5 M3a, ADR-013): xlsx/xls/csv/txt/docx → text.
enum DocumentConversionStatus {
  pending
  done
  /// Permanent: rejected by a limit or unreadable (reason says why). Never retried.
  failed
}

enum TranscriptionStatus {
  pending
  done
  /// Not transcribed by design: unsupported_format (aac/amr), quota_exceeded.
  skipped
  /// Invalid audio for the provider, media missing, or retries exhausted.
  failed
}

enum MediaStorageKind {
  postgres
}

enum WebhookProvider {
  whatsapp
}

enum WebhookEventStatus {
  received
  processed
  /// Nothing to process for this business number (e.g. Meta dashboard test payloads,
  /// another phone_number_id, fields not handled yet).
  ignored
  failed
}

// ─── Suppliers & contacts ───────────────────────────────────────────────────

model Supplier {
  id             String    @id @default(uuid(7)) @db.Uuid
  name           String
  /// normalizeSupplierName(name): matching of document supplier names (not unique).
  normalizedName String    @map("normalized_name")
  notes          String?
  /// Last tax basis (IVA) stated by this supplier's lists; null = never stated.
  taxIncluded    Boolean?  @map("tax_included")
  taxIncludedAt  DateTime? @map("tax_included_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  contacts      Contact[]
  products      Product[]
  ingestionRuns IngestionRun[]
  reviewItems   ReviewItem[]
  sheetFormats  SupplierSheetFormat[]

  @@index([normalizedName])
  @@map("suppliers")
}

/// Identity: phone (waId) and/or Meta business-scoped user id (bsuid). At least one is
/// required — CHECK `contacts_identity_chk` in migration `whatsapp_worker` (Prisma does
/// not model CHECKs; keep it when editing this model). Meta may omit the phone for users
/// with a WhatsApp username, and the BSUID changes if the user changes phone number.
model Contact {
  id          String       @id @default(uuid(7)) @db.Uuid
  /// WhatsApp id (phone number in international format, digits only). Null when Meta only sent a BSUID.
  waId        String?      @unique @map("wa_id")
  /// Business-scoped user id (e.g. "US.13491208655302741918"), from contacts[].user_id / from_user_id.
  bsuid       String?      @unique
  /// WhatsApp username, when the user adopted one.
  username    String?
  name        String?
  kind        ContactKind  @default(unknown)
  supplierId  String?      @map("supplier_id") @db.Uuid
  /// Consent for business-initiated messages (templates). Null = no opt-in → templates refused (ADR-009).
  optInAt     DateTime?    @map("opt_in_at") @db.Timestamptz(3)
  optInSource OptInSource? @map("opt_in_source")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  conversation Conversation?

  @@index([supplierId])
  @@map("contacts")
}

// ─── Conversations & messages ───────────────────────────────────────────────

/// One conversation per contact (per business number).
model Conversation {
  id            String           @id @default(uuid(7)) @db.Uuid
  contactId     String           @unique @map("contact_id") @db.Uuid
  mode          ConversationMode @default(bot)
  /// While mode = human, the bot reactivates after this instant (null = until manual reactivation).
  humanUntil    DateTime?        @map("human_until") @db.Timestamptz(3)
  /// Last inbound message from the contact — drives the 24h customer service window.
  lastInboundAt DateTime?        @map("last_inbound_at") @db.Timestamptz(3)
  lastMessageAt DateTime?        @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([mode, humanUntil])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String           @id @default(uuid(7)) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  /// WhatsApp message id (wamid). Unique → idempotency. Null for outbound messages not yet accepted by Meta.
  waMessageId    String?          @unique @map("wa_message_id")
  /// Outbound only: caller-provided key; retrying a send with the same key returns the same message.
  idempotencyKey String?          @unique @map("idempotency_key")
  direction      MessageDirection
  type           MessageType
  author         MessageAuthor
  /// Set when author = human and the reply came from the admin panel.
  authorUserId   String?          @map("author_user_id") @db.Uuid
  text           String?
  /// Speech-to-text output for audio messages.
  transcript     String?
  status         MessageStatus    @default(received)
  statusAt       DateTime?        @map("status_at") @db.Timestamptz(3)
  errorCode      String?          @map("error_code")
  errorMessage   String?          @map("error_message")
  /// Timestamp reported by WhatsApp.
  waTimestamp    DateTime?        @map("wa_timestamp") @db.Timestamptz(3)
  mediaFileId    String?          @unique @map("media_file_id") @db.Uuid
  /// Webhook delivery that created this message (inbound only).
  webhookEventId String?          @map("webhook_event_id") @db.Uuid
  /// Original message object from the webhook payload (for debugging / reprocessing).
  raw            Json?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation      Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorUser        User?                @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  mediaFile         MediaFile?           @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)
  webhookEvent      WebhookEvent?        @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)
  ingestionRuns     IngestionRun[]
  priceChanges      PriceChange[]
  statusEvents      MessageStatusEvent[]
  integrationEvents IntegrationEvent[]

  @@index([conversationId, createdAt])
  @@index([authorUserId])
  @@index([webhookEventId])
  @@map("messages")
}

/// Media metadata + download state. Bytes live in MediaBlob (see ADR-008).
model MediaFile {
  id            String            @id @default(uuid(7)) @db.Uuid
  waMediaId     String            @unique @map("wa_media_id")
  /// Mime type (from the webhook; replaced by Meta's media API value on download).
  mimeType      String            @map("mime_type")
  sizeBytes     Int?              @map("size_bytes")
  /// SHA-256 declared by Meta (webhook / media API), hex or base64 as Meta sends it.
  sha256        String?
  /// Lowercase hex SHA-256 of the stored bytes.
  contentSha256 String?           @map("content_sha256") @db.Char(64)
  filename      String?
  status        MediaStatus       @default(pending)
  storage       MediaStorageKind?
  /// Machine-readable reason when status = rejected | skipped | failed.
  rejectReason  String?           @map("reject_reason")
  /// Last error (download attempts), for diagnostics.
  error         String?
  attempts      Int               @default(0)
  downloadedAt  DateTime?         @map("downloaded_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  message            Message?
  blob               MediaBlob?
  transcription      Transcription?
  documentConversion DocumentConversion?

  @@index([status, createdAt])
  @@map("media_files")
}

/// Speech-to-text of an audio MediaFile (ADR-005, ADR-010). The text is also copied to
/// Message.transcript. durationSeconds is what providers bill (cost tracking).
/// Text version of a stored spreadsheet / CSV / text / Word document, used as
/// <document_text> by the extraction. Created (pending) in the same transaction that marks
/// the media stored; converted by the worker in an isolated thread (ADR-013).
model DocumentConversion {
  id               String                   @id @default(uuid(7)) @db.Uuid
  mediaFileId      String                   @unique @map("media_file_id") @db.Uuid
  status           DocumentConversionStatus @default(pending)
  /// Machine-readable reason when failed (zip_bomb, encrypted, timeout, too_large, …).
  reason           String?
  format           String?
  /// Markdown text (tables). Never logged.
  text             String?
  charCount        Int?                     @map("char_count")
  /// Lines that can be a product (table data rows / text lines with digits).
  dataRows         Int?                     @map("data_rows")
  /// A limit cut the content: the extraction never treats it as a full list.
  truncated        Boolean                  @default(false)
  /// Values may be missing (formula without cached value): every line goes to review.
  needsReview      Boolean                  @default(false) @map("needs_review")
  /// Typed tables of spreadsheets / CSV (deterministic path, phase 5 M3c).
  tables           Json?
  sheets           Json?
  warnings         Json?
  error            String?
  attempts         Int                      @default(0)
  durationMs       Int?                     @map("duration_ms")
  converterVersion String?                  @map("converter_version")
  completedAt      DateTime?                @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("document_conversions")
}

model Transcription {
  id              String              @id @default(uuid(7)) @db.Uuid
  mediaFileId     String              @unique @map("media_file_id") @db.Uuid
  status          TranscriptionStatus @default(pending)
  provider        String?
  model           String?
  /// Language requested (hint) or detected by the provider.
  language        String?
  text            String?
  durationSeconds Decimal?            @map("duration_seconds") @db.Decimal(10, 2)
  latencyMs       Int?                @map("latency_ms")
  attempts        Int                 @default(0)
  /// Machine-readable reason when skipped/failed (unsupported_format, quota_exceeded, …).
  reason          String?
  error           String?
  completedAt     DateTime?           @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("transcriptions")
}

/// One row per LLM call (or blocked attempt): the ledger behind the AI budget
/// (ADR-011). Never stores prompts or document content.
model AiUsage {
  id               String        @id @default(uuid(7)) @db.Uuid
  task             AiTask
  status           AiUsageStatus
  provider         String
  model            String
  inputTokens      Int           @default(0) @map("input_tokens")
  outputTokens     Int           @default(0) @map("output_tokens")
  cacheReadTokens  Int           @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int           @default(0) @map("cache_write_tokens")
  /// Estimated cost in USD from the pricing table (0 for fake / blocked calls).
  costUsd          Decimal       @default(0) @map("cost_usd") @db.Decimal(12, 6)
  latencyMs        Int?          @map("latency_ms")
  promptVersion    String?       @map("prompt_version")
  /// Machine-readable reason for error / budget_blocked.
  reason           String?
  error            String?
  ingestionRunId   String?       @map("ingestion_run_id") @db.Uuid
  messageId        String?       @map("message_id") @db.Uuid
  contactId        String?       @map("contact_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([contactId, task, createdAt])
  @@index([ingestionRunId])
  @@map("ai_usages")
}

/// Media bytes (ADR-008: Postgres bytea behind the MediaStorage interface). Separate
/// table so selecting media_files never loads the bytes. Column storage is EXTERNAL
/// (no TOAST compression: PDF/JPEG/OGG are already compressed) — set in migration
/// `media_storage`; keep it when editing this model.
model MediaBlob {
  mediaFileId String   @id @map("media_file_id") @db.Uuid
  data        Bytes
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  @@map("media_blobs")
}

/// Every signature-verified webhook delivery, stored before the 200 ack.
/// bodySha256 = SHA-256 of the RAW body: an identical re-delivery from Meta hits the
/// unique constraint and is not stored twice. Message-level idempotency is still
/// enforced by Message.waMessageId (a retry may batch events differently).
/// Retention: no cleanup job yet (see Known issues in CLAUDE.md).
model WebhookEvent {
  id          String             @id @default(uuid(7)) @db.Uuid
  provider    WebhookProvider
  /// Lowercase hex SHA-256 of the raw request body.
  bodySha256  String             @map("body_sha256") @db.Char(64)
  payload     Json
  status      WebhookEventStatus @default(received)
  attempts    Int                @default(0)
  error       String?
  receivedAt  DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  /// Set when a processing job was enqueued. Null + status received = the sweeper re-enqueues it.
  enqueuedAt  DateTime?          @map("enqueued_at") @db.Timestamptz(3)
  processedAt DateTime?          @map("processed_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  messages     Message[]
  statusEvents MessageStatusEvent[]

  @@unique([provider, bodySha256])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

/// Append-only log of WhatsApp delivery statuses (sent/delivered/read/played/failed).
/// Unique (waMessageId, status) → re-deliveries are ignored. messageId is null when the
/// message was not sent through this API (e.g. Meta dashboard test sends) or the status
/// arrived before the outbound Message stored its wamid.
model MessageStatusEvent {
  id              String    @id @default(uuid(7)) @db.Uuid
  waMessageId     String    @map("wa_message_id")
  /// Raw status value from Meta (kept as text to tolerate new values).
  status          String
  occurredAt      DateTime? @map("occurred_at") @db.Timestamptz(3)
  recipientWaId   String?   @map("recipient_wa_id")
  recipientUserId String?   @map("recipient_user_id")
  errors          Json?
  pricing         Json?
  messageId       String?   @map("message_id") @db.Uuid
  webhookEventId  String?   @map("webhook_event_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  webhookEvent WebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)

  @@unique([waMessageId, status])
  @@index([messageId])
  @@index([webhookEventId])
  @@map("message_status_events")
}

// ─── Catalog ────────────────────────────────────────────────────────────────

model Product {
  id             String    @id @default(uuid(7)) @db.Uuid
  supplierId     String    @map("supplier_id") @db.Uuid
  name           String
  /// Normalized name used for duplicate detection (unique per supplier).
  normalizedName String    @map("normalized_name")
  sku            String?
  unit           String?
  price          Decimal   @db.Decimal(18, 4)
  /// ISO 4217 code.
  currency       String    @db.Char(3)
  available      Boolean   @default(true)
  stock          Int?
  /// Last time the product appeared in a supplier list/update.
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(3)
  /// WhatsApp timestamp of the message that set the current price: an older message
  /// processed later never overwrites it (review stale_source).
  priceSourceAt  DateTime? @map("price_source_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier     Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  priceChanges PriceChange[]
  alerts       Alert[]
  reviewItems  ReviewItem[]

  @@unique([supplierId, normalizedName])
  @@map("products")
}

/// Append-only history of price changes.
/// If the currency changes, changePct is null and currencyChanged = true.
/// Enforced by CHECK constraints in migration `price_change_rules` (Prisma does not
/// model CHECKs; keep them when editing this model). Computed by
/// src/modules/catalog/price-change.ts.
model PriceChange {
  id              String            @id @default(uuid(7)) @db.Uuid
  productId       String            @map("product_id") @db.Uuid
  /// Null for the first price of a new product.
  oldPrice        Decimal?          @map("old_price") @db.Decimal(18, 4)
  oldCurrency     String?           @map("old_currency") @db.Char(3)
  newPrice        Decimal           @map("new_price") @db.Decimal(18, 4)
  newCurrency     String            @map("new_currency") @db.Char(3)
  /// (new - old) / old * 100, rounded to 4 decimals. Null when there is no old
  /// price, the old price is 0, or the currency changed. Unbounded numeric so
  /// outliers (e.g. +999900%) can still be recorded.
  changePct       Decimal?          @map("change_pct") @db.Decimal
  currencyChanged Boolean           @default(false) @map("currency_changed")
  /// auto = applied by the ingest; review = applied when a human approved a review item.
  /// Unique (ingestion_run_id, product_id) WHERE source = 'auto' — partial index in
  /// migration `catalog_ingest` (Prisma does not model it; keep it).
  source          PriceChangeSource @default(auto)
  reviewItemId    String?           @map("review_item_id") @db.Uuid
  ingestionRunId  String?           @map("ingestion_run_id") @db.Uuid
  sourceMessageId String?           @map("source_message_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingestionRun  IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)
  sourceMessage Message?      @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  reviewItem    ReviewItem?   @relation(fields: [reviewItemId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([reviewItemId])
  @@index([ingestionRunId])
  @@index([sourceMessageId])
  @@map("price_changes")
}

/// One classification + extraction + ingestion attempt for a message.
model IngestionRun {
  id               String                   @id @default(uuid(7)) @db.Uuid
  messageId        String                   @map("message_id") @db.Uuid
  supplierId       String?                  @map("supplier_id") @db.Uuid
  classification   IngestionClassification?
  status           IngestionStatus          @default(pending)
  /// Deterministic pre-filter rule that classified the message WITHOUT the LLM (phase 6).
  prefilterRule    String?                  @map("prefilter_rule")
  /// Raw structured output from the extractor (validated before ingestion).
  rawExtraction    Json?                    @map("raw_extraction")
  /// Ingestion report: created/updated/unchanged/unavailable products, warnings.
  report           Json?
  errors           Json?
  model            String?
  inputTokens      Int?                     @map("input_tokens")
  outputTokens     Int?                     @map("output_tokens")
  /// Prompt-cache tokens (reads 0.1x, writes 1.25x of the input price).
  cacheReadTokens  Int?                     @map("cache_read_tokens")
  cacheWriteTokens Int?                     @map("cache_write_tokens")
  /// Estimated cost of every LLM call of this run (sum of ai_usages.cost_usd).
  costUsd          Decimal?                 @map("cost_usd") @db.Decimal(12, 6)
  /// Hash of the prompt files used (classifier/extractor), for traceability.
  promptVersion    String?                  @map("prompt_version")
  latencyMs        Int?                     @map("latency_ms")
  finishedAt       DateTime?                @map("finished_at") @db.Timestamptz(3)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  message      Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  priceChanges PriceChange[]
  alerts       Alert[]
  aiUsages     AiUsage[]
  reviewItems  ReviewItem[]

  @@index([status, createdAt])
  @@index([messageId])
  @@index([supplierId])
  @@index([prefilterRule, createdAt])
  @@map("ingestion_runs")
}

// ─── Alerts, settings, users, audit ─────────────────────────────────────────

/// One decision a human must take (ADR-012). Created by the catalog ingest (line,
/// catalog) or when a run cannot proceed (run gates). Resolved by approve/reject.
model ReviewItem {
  id             String       @id @default(uuid(7)) @db.Uuid
  ingestionRunId String       @map("ingestion_run_id") @db.Uuid
  supplierId     String?      @map("supplier_id") @db.Uuid
  /// Target or best candidate product (null for new products and run gates).
  productId      String?      @map("product_id") @db.Uuid
  scope          ReviewScope
  kind           ReviewKind
  status         ReviewStatus @default(pending)
  /// Unique per run: "line:<index>", "unavailable:<productId>", "global", "gate:<kind>".
  dedupeKey      String       @map("dedupe_key")
  /// Reason codes (a line can have several, e.g. price_outlier + uncertain_value).
  reasons        String[]
  /// What is proposed (Decimals as strings): line, prices, candidates, preview.
  proposal       Json
  /// Product price/currency when proposed; approving a stale proposal fails (superseded).
  basePrice      Decimal?     @map("base_price") @db.Decimal(18, 4)
  baseCurrency   String?      @map("base_currency") @db.Char(3)
  resolution     Json?
  resolvedById   String?      @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  ingestionRun IngestionRun  @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  resolvedBy   User?         @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  priceChanges PriceChange[]

  @@unique([ingestionRunId, dedupeKey])
  @@index([status, createdAt])
  @@index([supplierId, status])
  @@index([productId, status])
  @@map("review_items")
}

/// Spreadsheet format of a supplier (phase 5 M3c, ADR-014): the column mapping approved by
/// a human for a header fingerprint. Several formats per supplier can be active (different
/// spreadsheets); at most ONE active per (supplier, fingerprint) — partial unique index in
/// migration `sheet_formats` (keep it). A format that fails validation is retired, never
/// deleted, and the table is mapped again.
model SupplierSheetFormat {
  id            String            @id @default(uuid(7)) @db.Uuid
  supplierId    String            @map("supplier_id") @db.Uuid
  /// sha256 of the normalized header cells (headerFingerprint).
  fingerprint   String
  headerCells   Json              @map("header_cells")
  sheetName     String?           @map("sheet_name")
  /// SheetMapping (columns, price format, currency, taxIncluded, price candidates).
  mapping       Json
  status        SheetFormatStatus @default(active)
  approvedById  String?           @map("approved_by_id") @db.Uuid
  approvedAt    DateTime          @default(now()) @map("approved_at") @db.Timestamptz(3)
  /// Review item that approved it.
  reviewItemId  String?           @map("review_item_id") @db.Uuid
  timesUsed     Int               @default(0) @map("times_used")
  lastUsedAt    DateTime?         @map("last_used_at") @db.Timestamptz(3)
  retiredAt     DateTime?         @map("retired_at") @db.Timestamptz(3)
  retiredReason String?           @map("retired_reason")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  approvedBy User?    @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([supplierId, fingerprint])
  @@map("supplier_sheet_formats")
}

/// Outbox towards n8n (phase 6, ADR-015): created in the SAME transaction that makes a
/// message ready (text ingested, media stored/failed, transcription or conversion finished);
/// delivered by the pg-boss queue n8n-delivery with retries. dedupeKey is unique: at most
/// one "message.ready" per message. The payload carries ids only (no message content).
model IntegrationEvent {
  id           String                 @id @default(uuid(7)) @db.Uuid
  type         String
  messageId    String?                @map("message_id") @db.Uuid
  payload      Json
  status       IntegrationEventStatus @default(pending)
  dedupeKey    String                 @unique @map("dedupe_key")
  attempts     Int                    @default(0)
  /// Times the watchdog sent it again after delivery (n8n accepted but never processed it).
  redeliveries Int                    @default(0)
  lastError    String?                @map("last_error")
  deliveredAt  DateTime?              @map("delivered_at") @db.Timestamptz(3)
  failedAt     DateTime?              @map("failed_at") @db.Timestamptz(3)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([messageId])
  @@map("integration_events")
}

/// One actionable event for one recipient ("panel" or a team member waId). dedupeKey makes
/// repeated n8n calls harmless. WhatsApp recipients get it through a digest.
model NotificationItem {
  id        String               @id @default(uuid(7)) @db.Uuid
  recipient String
  category  NotificationCategory
  severity  AlertSeverity        @default(info)
  dedupeKey String               @map("dedupe_key")
  title     String
  data      Json
  digestId  String?              @map("digest_id") @db.Uuid
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  digest NotificationDigest? @relation(fields: [digestId], references: [id], onDelete: SetNull)

  @@unique([recipient, dedupeKey])
  @@index([recipient, createdAt])
  @@index([digestId])
  @@map("notification_items")
}

/// One WhatsApp message to one team member grouping several items (anti-spam, phase 6).
model NotificationDigest {
  id                String                   @id @default(uuid(7)) @db.Uuid
  recipient         String
  status            NotificationDigestStatus @default(open)
  /// Critical digests skip the grouping window (own hourly cap).
  critical          Boolean                  @default(false)
  windowEndsAt      DateTime                 @map("window_ends_at") @db.Timestamptz(3)
  sentAt            DateTime?                @map("sent_at") @db.Timestamptz(3)
  text              String?
  /// text | template | panel_only
  channel           String?
  outboundMessageId String?                  @map("outbound_message_id") @db.Uuid
  error             String?
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  items NotificationItem[]

  @@index([recipient, status])
  @@index([recipient, sentAt])
  @@map("notification_digests")
}

model Alert {
  id             String        @id @default(uuid(7)) @db.Uuid
  type           AlertType
  severity       AlertSeverity @default(info)
  status         AlertStatus   @default(open)
  title          String
  payload        Json?
  productId      String?       @map("product_id") @db.Uuid
  ingestionRunId String?       @map("ingestion_run_id") @db.Uuid
  sentAt         DateTime?     @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([productId])
  @@index([ingestionRunId])
  @@map("alerts")
}

/// No-code rules/config as key → JSON value. Each key is validated with Zod in the service layer.
model Setting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("settings")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(operator)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  messages             Message[]
  settings             Setting[]
  auditLogs            AuditLog[]
  resolvedReviews      ReviewItem[]
  approvedSheetFormats SupplierSheetFormat[]

  @@map("users")
}

/// Append-only audit trail.
model AuditLog {
  id        String         @id @default(uuid(7)) @db.Uuid
  actorType AuditActorType @map("actor_type")
  userId    String?        @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?        @map("entity_id")
  data      Json?
  requestId String?        @map("request_id")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
