# Local public demo (phase 9 M8, ADR-021): copy to .env.demo and run
#   pnpm --filter @smartops/api dev:demo      (API + worker; .env first, then these override it)
#   pnpm --filter @smartops/admin dev         (panel on http://localhost:3000)
# Seed first: pnpm --filter @smartops/api demo:seed   (uses DEMO_DATABASE_URL from .env)
#
# The demo database (name MUST end in _demo) — the same as DEMO_DATABASE_URL in .env.
DATABASE_URL=postgresql://smartops:change-me@localhost:5432/smartops_demo
DEMO_MODE=true
# n8n (docker) calls the API on :4000 with the same INTERNAL_API_KEY: keep the demo on 4000
# and the published workflows orchestrate the demo too.
N8N_DELIVERY_ENABLED=true
# Phone through a tunnel (cloudflared tunnel --url http://localhost:3000): add its https
# origin so the login's Origin check accepts it, e.g.
# CORS_ORIGINS=http://localhost:3000,https://xxxx.trycloudflare.com
DEMO_RESET_INTERVAL_MINUTES=60
